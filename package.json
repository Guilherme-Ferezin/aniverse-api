{
  "name": "aniverse-api",
  "version": "1.0.0",
  "description": "AniVerse — Anime Tracker: API REST (Node.js + Express + MySQL) e front-end React",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon --watch src src/server.js",
    "importar": "node scripts/importar-animes.js",
    "seed": "node scripts/importar-animes.js --local",
    "capas": "node scripts/atualizar-capas.js",
    "catalogo": "node scripts/importar-anilist.js",
    "frontend:install": "npm --prefix frontend install",
    "frontend": "npm --prefix frontend run dev"
  },
  "engines": { "node": ">=18" },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.11.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.0"
  }
}
