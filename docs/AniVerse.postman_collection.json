{
  "info": {
    "name": "AniVerse API",
    "description": "Rode na ordem: Registrar, Login (salva o token automaticamente) e depois as demais pastas.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "animeId",
      "value": "1"
    },
    {
      "key": "generoId",
      "value": "1"
    },
    {
      "key": "itemId",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "1. Autenticação",
      "item": [
        {
          "name": "Registrar usuário",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Maria Silva\",\n  \"email\": \"maria@email.com\",\n  \"senha\": \"123456\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Login (salva o token)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"maria@email.com\",\n  \"senha\": \"123456\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const dados = pm.response.json();",
                  "if (dados.token) { pm.collectionVariables.set('token', dados.token); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Login com senha errada (401)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"maria@email.com\",\n  \"senha\": \"errada\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Rota privada sem token (401)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/animes",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "animes"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          }
        }
      ]
    },
    {
      "name": "2. Perfil",
      "item": [
        {
          "name": "Ver perfil",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/perfil",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "perfil"
              ]
            }
          }
        },
        {
          "name": "Editar perfil",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/perfil",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "perfil"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Maria S. Oliveira\",\n  \"email\": \"maria@email.com\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    },
    {
      "name": "3. Gêneros",
      "item": [
        {
          "name": "Listar gêneros",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/generos",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "generos"
              ]
            }
          }
        },
        {
          "name": "Criar gênero",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/generos",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "generos"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Mecha\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const dados = pm.response.json();",
                  "if (dados.id) { pm.collectionVariables.set('generoId', dados.id); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Buscar gênero por ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/generos/{{generoId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "generos",
                "{{generoId}}"
              ]
            }
          }
        },
        {
          "name": "Editar gênero",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/generos/{{generoId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "generos",
                "{{generoId}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Mecha / Robôs\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Excluir gênero",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/generos/{{generoId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "generos",
                "{{generoId}}"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "4. Animes",
      "item": [
        {
          "name": "Cadastrar anime",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/animes",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "animes"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"titulo\": \"Fullmetal Alchemist: Brotherhood\",\n  \"sinopse\": \"Dois irmãos usam alquimia para tentar recuperar o que perderam.\",\n  \"estudio\": \"Bones\",\n  \"ano_lancamento\": 2009,\n  \"total_episodios\": 64,\n  \"capa_url\": \"https://exemplo.com/fma.jpg\",\n  \"generos\": [\n    1,\n    2,\n    5\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const dados = pm.response.json();",
                  "if (dados.id) { pm.collectionVariables.set('animeId', dados.id); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Listar animes",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/animes",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "animes"
              ]
            }
          }
        },
        {
          "name": "Buscar por título",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/animes?busca=full",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "animes"
              ],
              "query": [
                {
                  "key": "busca",
                  "value": "full"
                }
              ]
            }
          }
        },
        {
          "name": "Filtrar por gênero",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/animes?genero=1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "animes"
              ],
              "query": [
                {
                  "key": "genero",
                  "value": "1"
                }
              ]
            }
          }
        },
        {
          "name": "Buscar anime por ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/animes/{{animeId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "animes",
                "{{animeId}}"
              ]
            }
          }
        },
        {
          "name": "Editar anime",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/animes/{{animeId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "animes",
                "{{animeId}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"titulo\": \"Fullmetal Alchemist: Brotherhood\",\n  \"sinopse\": \"Sinopse atualizada.\",\n  \"estudio\": \"Bones\",\n  \"ano_lancamento\": 2009,\n  \"total_episodios\": 64,\n  \"generos\": [\n    1,\n    4\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Excluir anime",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/animes/{{animeId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "animes",
                "{{animeId}}"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "5. Minha coleção",
      "item": [
        {
          "name": "Adicionar à coleção",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/colecao",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "colecao"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"anime_id\": \"{{animeId}}\",\n  \"status\": \"assistindo\",\n  \"episodios_assistidos\": 10\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const dados = pm.response.json();",
                  "if (dados.id) { pm.collectionVariables.set('itemId', dados.id); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Listar minha coleção",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/colecao",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "colecao"
              ]
            }
          }
        },
        {
          "name": "Filtrar por status",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/colecao?status=assistindo",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "colecao"
              ],
              "query": [
                {
                  "key": "status",
                  "value": "assistindo"
                }
              ]
            }
          }
        },
        {
          "name": "Buscar item por ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/colecao/{{itemId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "colecao",
                "{{itemId}}"
              ]
            }
          }
        },
        {
          "name": "Atualizar (concluir e avaliar)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/colecao/{{itemId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "colecao",
                "{{itemId}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"concluido\",\n  \"nota\": 10,\n  \"episodios_assistidos\": 64\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Remover da coleção",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/colecao/{{itemId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "colecao",
                "{{itemId}}"
              ]
            }
          }
        }
      ]
    }
  ]
}